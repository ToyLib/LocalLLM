{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch LocalLLM (Windows, Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/LocalLLM.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
            "name": "Launch LocalLLM (Windows, Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/LocalLLM.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build (Release)"
        },
        {
            "name": "Launch LocalLLM (Linux, Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/LocalLLM",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            // ログ (SDL_Log) は統合ターミナルに出力
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
            "name": "Launch LocalLLM (Linux, Release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-release/LocalLLM",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build (Release)"
        },
        {
            "name": "Launch LocalLLM (macOS, Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/LocalLLM",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
            "name": "Launch LocalLLM (macOS, Release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-release/LocalLLM",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "CMake: build (Release)"
        },
        {
            // Python 版 (全 OS 共通、ビルド不要)。インタープリターは VS Code で選択中のものを使う
            "name": "Launch LocalLLM (Python)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/main.py",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
